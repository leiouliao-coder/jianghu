[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/bootstrap.gd" id="1"]

[node name="Bootstrap" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.06, 0.09, 0.10, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 28
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 28

[node name="Content" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Title" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 36
text = "JIANGHU / 江湖"

[node name="Notice" type="Label" parent="Margin/Content"]
layout_mode = 2
text = "开发入口 · Development entry\n可先检查服务端，再进入账号登录。当前可以登录、创建角色，并在六区块灰盒世界中移动；尚无战斗、物品与任务。"
autowrap_mode = 3

[node name="AddressLabel" type="Label" parent="Margin/Content"]
layout_mode = 2
text = "开发服务器地址（手机测试请改为电脑的局域网地址）"
autowrap_mode = 3

[node name="ServerAddress" type="LineEdit" parent="Margin/Content"]
layout_mode = 2
custom_minimum_size = Vector2(0, 48)
text = "http://127.0.0.1:8080"
placeholder_text = "http://192.168.1.10:8080"

[node name="CheckHealth" type="Button" parent="Margin/Content"]
layout_mode = 2
custom_minimum_size = Vector2(0, 52)
text = "检查服务端 / Check health"

[node name="Status" type="Label" parent="Margin/Content"]
layout_mode = 2
text = "尚未连接 / Not connected"
autowrap_mode = 3

[node name="OpenAccount" type="Button" parent="Margin/Content"]
layout_mode = 2
custom_minimum_size = Vector2(0, 52)
text = "账号登录 / Account"

[node name="Scope" type="Label" parent="Margin/Content"]
layout_mode = 2
size_flags_vertical = 3
text = "目标平台：Windows / macOS / iOS / Android（手机目前只支持点地面移动）\n账号登录需要服务端配置数据库。"
autowrap_mode = 3

[node name="HealthRequest" type="HTTPRequest" parent="."]
timeout = 5.0
body_size_limit = 65536
max_redirects = 0
