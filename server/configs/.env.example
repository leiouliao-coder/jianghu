# Documentation only: the server does not automatically read this file.
JIANGHU_LISTEN_ADDR=127.0.0.1:8080
# Optional. Without it the server runs diagnostics only. Example for compose.yaml:
# JIANGHU_DATABASE_URL=postgres://jianghu:jianghu-dev@127.0.0.1:5433/jianghu?sslmode=disable
# Path to shared/data; default ../shared/data (run from server/).
# JIANGHU_DATA_DIR=../shared/data
